# CLI tooling lives in ~/.config/mise/config.toml (cross-platform).
# This file is macOS-only: casks, system libraries, and shell integration.

# Bootstrap
brew "chezmoi"
brew "mise"
brew "topgrade"

# System libraries
brew "gmp"
brew "libyaml"
brew "openssl@3"

# Base system tools
brew "bash"
brew "git"
brew "hashcat"
brew "mosh"
brew "telnet"
brew "tree"
brew "watch"
brew "wget"

# Shell integration
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

#brew "juju"
#brew "pixi"   # also available via mise
brew "mcp-proxy"
brew "aisk/tap/timeout", trusted: true

cask "appcleaner"
#cask "coteditor"
cask "cyberduck"
cask "dbeaver-community"
cask "firefox"
cask "font-jetbrains-mono-nerd-font"
cask "jetbrains-toolbox"
cask "keka"
cask "logi-options+"
cask "microsoft-teams"
#cask "gg"
cask "orbstack"
#cask "onedrive"
cask "slack"
cask "stats"
cask "taskpaper"
cask "zed"

{{ if eq .machine_type "personal" }}
cask "google-chrome"
cask "superduper"
cask "surfshark"
cask "tor-browser"
cask "vlc"
#cask "gimp"
#cask "adobe-acrobat-reader"
{{ else }}
cask "git-credential-manager"
brew "openfortivpn"
{{ end }}

{{ if .needs_k8s }}
cask "freelens"
{{ end }}
