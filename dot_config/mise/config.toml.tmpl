ripgrep = "latest"
starship = "latest"
tmux = "latest"
jq = "latest"
yq = "latest"
cloc = "latest"

# Dev tooling
bun = "latest"
go = "latest"
rust = "latest"
uv = "latest"
java = "zulu-21"
just = "latest"
task = "latest"
act = "latest"
prek = "latest"
github-cli = "latest"
gitleaks = "latest"
git-lfs = "latest"
jj = "latest"
copier = "latest"
xcodegen = "latest"
"pipx:poethepoet" = "latest"

# Cloud / data (unconditional, as in the Brewfile)
