#!/bin/bash
{{ range (glob (joinPath .chezmoi.sourceDir "dot_config/mise/**/*.toml")) -}}
# mise config hash: {{ include . | sha256sum }}
{{ end -}}
# brewfile hash: {{ include "dot_config/homebrew/Brewfile" | sha256sum }}
{{ if eq .machine_type "home" -}}
# brewfile hash: {{ include "dot_config/homebrew/home.Brewfile" | sha256sum }}
{{ else if eq .machine_type "linkit" -}}
# brewfile hash: {{ include "dot_config/homebrew/linkit.Brewfile" | sha256sum }}
{{ else -}}
# brewfile hash: {{ include "dot_config/homebrew/htc.Brewfile" | sha256sum }}
{{ end -}}
set -euo pipefail

if ! command -v mise &> /dev/null; then
    echo "Installing mise..."
    curl -fsSL https://mise.run | sh
fi
export PATH="$HOME/.local/bin:$PATH"

{{ if eq .chezmoi.os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ end -}}

# From $HOME so only the global config counts - `chezmoi apply` run inside a
# project would otherwise install that project's tools too.
cd "$HOME"
mise bootstrap --only packages,tools,macos-defaults --yes

{{ if eq .chezmoi.os "darwin" -}}
echo "Installing Homebrew casks..."
brew bundle --file="$HOME/.config/homebrew/Brewfile"
{{ if eq .machine_type "home" -}}
brew bundle --file="$HOME/.config/homebrew/home.Brewfile"
{{ else if eq .machine_type "linkit" -}}
brew bundle --file="$HOME/.config/homebrew/linkit.Brewfile"
{{ else -}}
brew bundle --file="$HOME/.config/homebrew/htc.Brewfile"
{{ end -}}
# Homebrew 6 always quarantines casks; a reinstall then demands a new Allow.
caskroom="$(brew --prefix)/Caskroom"
if [[ -d $caskroom ]]; then
  find "$caskroom" -name '*.app' -exec xattr -dr com.apple.quarantine {} + 2>/dev/null || true
fi
find /Applications -maxdepth 1 -name '*.app' -exec xattr -dr com.apple.quarantine {} + 2>/dev/null || true
{{ end -}}
