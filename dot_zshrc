# ~/.zshrc - Optimized

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

export PATH="$HOME/.local/bin:$PATH"
export EDITOR=nano
export SPARK_LOCAL_IP=127.0.0.1
# let uv build venvs from the mise-provided interpreter instead of
# downloading its own copy of the same version
export UV_PYTHON_PREFERENCE=only-system

# Completions (must be before compinit)
fpath+=($HOMEBREW_PREFIX/share/zsh/site-functions(N))
autoload -Uz compinit && compinit -C
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# mise - must come before anything that runs a mise-managed binary
eval "$(mise activate zsh)"
# mise ships no completion file; the generated script self-registers via compdef
eval "$(mise completion zsh)"

# Starship prompt
eval "$(starship init zsh)"

# Plugins - first match wins across brew, distro and nix prefixes
zplug() {
  local name=$1
  local f=({/usr,/usr/local,/opt/homebrew,/home/linuxbrew/.linuxbrew,$HOME/.nix-profile}/share/{zsh/plugins/,}$name/$name.zsh(N))
  (( $#f )) && source $f[1]
}
zplug zsh-autosuggestions
zplug zsh-syntax-highlighting

# FZF integration
eval "$(fzf --zsh)"
bindkey '^I' expand-or-complete  # Restore standard tab completion

get-forti-cert() {
  echo | openssl s_client -connect "$1" 2>/dev/null \
    | openssl x509 -fingerprint -sha256 -noout \
    | sed 's/.*=//; s/://g' | tr 'A-F' 'a-f'
}

# `mise bootstrap packages use` adds a host package, but mise has no removal
# counterpart and deleting the line from ~/.config only lasts until the next
# `chezmoi apply` - so edit the source and let apply propagate it. Uninstalls
# nothing: prune runs as a dry-run, from $HOME so only the global config counts.
misedrop() {
  local pkg=$1
  if [[ -z $pkg ]]; then
    print -u2 "usage: misedrop <manager:package>   e.g. misedrop brew:tree"
    return 2
  fi
  local dir="$(chezmoi source-path)/dot_config/mise" hits
  hits=$(grep -rlF -- "\"$pkg\"" $dir)
  if [[ -z $hits ]]; then
    if grep -rqF -- "$pkg" $dir; then
      print -u2 "misedrop: $pkg is not a host package key - tools go via: mise unuse -g $pkg"
    else
      print -u2 "misedrop: $pkg is not declared in $dir"
    fi
    return 1
  fi
  local f
  for f in ${(f)hits}; do
    grep -vF -- "\"$pkg\"" $f > $f.new
    [[ -s $f.new ]] || { rm -f $f.new; print -u2 "misedrop: refusing to empty $f"; return 1 }
    mv $f.new $f
    print "removed $pkg from ${f:t}"
  done
  chezmoi apply && mise -C "$HOME" bootstrap packages prune --dry-run
}

# Aliases
export EZA_ICONS_AUTO=1
alias ls='eza'
alias ll='eza -la'
alias tree='eza --tree'
alias cat='bat'
alias htc-vpn='sudo openfortivpn -q --trusted-cert "$(get-forti-cert vpn.humantotalcare.nl:443)" --set-dns=1 --pppd-use-peerdns=1'
alias czpush='chezmoi re-add && chezmoi git add . && chezmoi git commit && chezmoi git push && exit'

# History
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY HIST_IGNORE_DUPS

export PAGER=cat
export GIT_PAGER=cat
export SYSTEMD_PAGER=cat
