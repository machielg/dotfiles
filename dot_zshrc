# ~/.zshrc - Optimized

# Startup profiling: no-op unless ZSHRC_PROFILE is set, so normal shells pay
# nothing. Run `ZSHRC_PROFILE=1 zsh` to see a per-section timing breakdown.
if [[ -n $ZSHRC_PROFILE ]]; then
  zmodload zsh/datetime
  typeset -F _prof_last=$EPOCHREALTIME
  _prof() {
    local now=$EPOCHREALTIME
    printf '%8.1fms  %s\n' $(( (now - _prof_last) * 1000 )) "$1" >&2
    _prof_last=$now
  }
else
  _prof() { :; }
fi

# Homebrew - shellenv output is static per install location, so cache it
# and only regenerate when the brew binary itself changes (upgrade/reinstall).
# `-nt` is a plain file-mtime test, no subprocess, so this check is ~free.
if [[ -x /opt/homebrew/bin/brew ]]; then
  _brew_bin=/opt/homebrew/bin/brew
elif [[ -x /usr/local/bin/brew ]]; then
  _brew_bin=/usr/local/bin/brew
fi
if [[ -n $_brew_bin ]]; then
  _brew_env_cache=$HOME/.cache/zsh/brew-shellenv.zsh
  [[ -d ${_brew_env_cache:h} ]] || mkdir -p ${_brew_env_cache:h}
  [[ ! -e $_brew_env_cache || $_brew_bin -nt $_brew_env_cache ]] && $_brew_bin shellenv > $_brew_env_cache
  source $_brew_env_cache
fi
unset _brew_bin _brew_env_cache
_prof "brew shellenv"

export PATH="$HOME/.local/bin:$PATH"
export EDITOR=nano
export SPARK_LOCAL_IP=127.0.0.1
# let uv build venvs from the mise-provided interpreter instead of
# downloading its own copy of the same version
export UV_PYTHON_PREFERENCE=only-system

# Completions (must be before compinit)
fpath+=($HOMEBREW_PREFIX/share/zsh/site-functions(N) $HOME/.cache/zsh/completions(N))
autoload -Uz compinit && compinit -C
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
_prof "compinit"

# mise - must come before anything that runs a mise-managed binary
eval "$(mise activate zsh)"
_prof "mise activate"
# mise ships no completion file; the generated script self-registers via compdef
eval "$(mise completion zsh)"
_prof "mise completion"
eval "$(carapace _carapace zsh)"
_prof "carapace"
# uv completion - eval'ing ~7000 lines fresh every shell is most of this
# block's cost (zsh parsing it immediately, not the subprocess). Freeze it
# to a file on fpath instead so it's autoloaded lazily on first Tab, and
# only regenerate when the uv binary itself changes.
_uv_bin=$(command -v uv)
if [[ -n $_uv_bin ]]; then
  _uv_completion_dir=$HOME/.cache/zsh/completions
  _uv_completion=$_uv_completion_dir/_uv
  [[ -d $_uv_completion_dir ]] || mkdir -p $_uv_completion_dir
  if [[ ! -e $_uv_completion || $_uv_bin -nt $_uv_completion ]]; then
    uv generate-shell-completion zsh > $_uv_completion
    # compinit -C blindly trusts the existing dump and won't notice a new/
    # changed fpath file on its own; drop the dump once so the next shell
    # rebuilds it, then subsequent shells go back to the cheap -C path.
    rm -f ~/.zcompdump
  fi
fi
unset _uv_bin _uv_completion_dir _uv_completion
_prof "uv completion"

# Starship prompt
eval "$(starship init zsh)"
_prof "starship init"

# Plugins - Apple Silicon Homebrew only; HOMEBREW_PREFIX is set above by
# `brew shellenv`. The old version globbed 10 candidate paths (Intel brew,
# linuxbrew, nix, generic /usr) per plugin to stay portable across machines
# this box will never be, which cost ~110ms/shell doing stats on paths that
# don't exist here.
zplug() {
  local name=$1
  local f=($HOMEBREW_PREFIX/share/$name/$name.zsh(N))
  (( $#f )) && source $f[1]
}
zplug zsh-autosuggestions
zplug zsh-syntax-highlighting
_prof "plugins"

# FZF integration
eval "$(fzf --zsh)"
bindkey '^I' expand-or-complete  # Restore standard tab completion
_prof "fzf"

# Keep the Codex daemon from starting automatically in shell sessions.
codex() {
  command codex --disable daemon_auto_start "$@"
}

get-forti-cert() {
  echo | openssl s_client -connect "$1" 2>/dev/null \
    | openssl x509 -fingerprint -sha256 -noout \
    | sed 's/.*=//; s/://g' | tr 'A-F' 'a-f'
}

# `mise bootstrap packages use` adds a host package, but mise has no removal
# counterpart and deleting the line from ~/.config only lasts until the next
# `chezmoi apply` - so edit the source and let apply propagate it. Uninstalls
# nothing: prune runs as a dry-run, from $HOME so only the global config counts.
misedrop() {
  local pkg=$1
  if [[ -z $pkg ]]; then
    print -u2 "usage: misedrop <manager:package>   e.g. misedrop brew:tree"
    return 2
  fi
  local dir="$(chezmoi source-path)/dot_config/mise" hits
  hits=$(grep -rlF -- "\"$pkg\"" $dir)
  if [[ -z $hits ]]; then
    if grep -rqF -- "$pkg" $dir; then
      print -u2 "misedrop: $pkg is not a host package key - tools go via: mise unuse -g $pkg"
    else
      print -u2 "misedrop: $pkg is not declared in $dir"
    fi
    return 1
  fi
  local f
  for f in ${(f)hits}; do
    grep -vF -- "\"$pkg\"" $f > $f.new
    [[ -s $f.new ]] || { rm -f $f.new; print -u2 "misedrop: refusing to empty $f"; return 1 }
    mv $f.new $f
    print "removed $pkg from ${f:t}"
  done
  chezmoi apply && mise -C "$HOME" bootstrap packages prune --dry-run
}

czc() {
  chezmoi git add .
  if git -C "$(chezmoi source-path)" diff --cached --quiet; then
    print "chezmoi: nothing to commit"
    return 0
  fi
  chezmoi git commit "$@"
}

# Aliases
export EZA_ICONS_AUTO=1
alias ls='eza'
alias ll='eza -la'
alias tree='eza --tree'
alias cat='bat'
alias htc-vpn='sudo openfortivpn -q --trusted-cert "$(get-forti-cert vpn.humantotalcare.nl:443)" --set-dns=1 --pppd-use-peerdns=1'
alias czpush='chezmoi re-add && czc && chezmoi git push && exit'

# History
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY HIST_IGNORE_DUPS

export PAGER=cat
export GIT_PAGER=cat
export SYSTEMD_PAGER=cat

_prof "aliases, functions, history"
unset -f _prof
unset _prof_last
